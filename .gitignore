# Build output
/target/
/target-*/
/web/target/
/web/www/w53ga_web.wasm
*.wasm

# Never commit anything from a unit: flash dumps, controller images, update packages, saved states (they contain the
# flash image and RAM), SD card copies, or anything the emulator writes.
*.bin
*.BIN
*.rom
*.img
*.state
*.spi
*.dump
*.bmp
*.wav
# Optional build-time input the repository does not ship (see README, "HLE profiles").
/profiles/*
!/profiles/README.md
/states/
/dumps/
/flash/
/sd/
/SD/
/sdcard/
/SDCard*/
/card/
/CELLSTAR/
/MAP/
/SOUND/
screenshot-*.png
w53ga-*.png
w53ga-*.state
*.local.*
.env
# Personal files (custom GPS routes, notes with real places or paths): kept in local/, never committed.
/local/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
