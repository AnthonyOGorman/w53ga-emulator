/data/
/profiles/
/states/
/dumps/
/flash/
/sd/
/SD/
/sdcard/
/SDCard*/
/card/
/CELLSTAR/
/MAP/
/SOUND/
screenshot-*.png
w53ga-*.png
w53ga-*.state
*.local.*
.env

